# Sign-in methods (enable either or both)
AUTH_AZURE=true
AUTH_LOCAL=true
# Optional: first password for admins listed below (only applies to admins with no password yet; remove after first start)
ADMIN_PASSWORD=
TENANT_ID=your-directory-tenant-id
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-client-secret-value
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@yourcompany.com
PORT=3000
# Set to 1 ONLY when a reverse proxy (e.g. Caddy) is in front. Leave unset if the app is reachable directly.
TRUST_PROXY=
# Hostname or IP people use to reach the app over HTTPS (used by Caddyfile / docker-compose.https.yml)
TOIL_HOST=
